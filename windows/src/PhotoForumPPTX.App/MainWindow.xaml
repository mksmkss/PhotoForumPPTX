<Window x:Class="PhotoForumPPTX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoForumPPTX.App"
        mc:Ignorable="d"
        Title="写真フォーラムPPTX" Height="640" Width="1000" MinHeight="560" MinWidth="820"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:ThumbnailConverter x:Key="ThumbnailConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="使い方(_U)" Click="OnOpenHelpClick" />
                <MenuItem Header="新機能(更新履歴)(_W)" Click="OnOpenWhatsNewClick" />
                <Separator />
                <MenuItem Header="不具合・要望を報告 (GitHub Issue)…" Click="OnReportIssueClick" />
                <MenuItem Header="GitHub リポジトリを開く" Click="OnOpenRepoClick" />
            </MenuItem>
        </Menu>

        <Border x:Name="UpdateBanner" Grid.Row="1" Padding="10" Background="#DCEBFC"
                Visibility="{Binding Available, Converter={StaticResource NullToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="{Binding Available.Version, StringFormat=新しい版 v{0} があります}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding Installing, Converter={StaticResource InverseBoolToVis}}">
                    <Button Content="あとで" Command="{Binding DismissCommand}" Padding="8,4" Margin="0,0,8,0" />
                    <Button Content="今すぐ更新" Command="{Binding InstallCommand}" Padding="8,4" FontWeight="Bold" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding Installing, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="更新中…" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 左: 写真一覧 -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <Button Content="写真を選択…" Command="{Binding AddPhotosDialogCommand}" Padding="10,5" />
                        <TextBlock Text="(ドラッグ&amp;ドロップも可)" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Button Content="書き出し (.pptx)" Command="{Binding ExportCommand}" DockPanel.Dock="Right"
                                Padding="10,5" FontWeight="Bold" />
                        <Button Content="設定…" Click="OnOpenSettingsClick" DockPanel.Dock="Right" Padding="10,5" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>

                <TextBlock Text="写真を選ぶと、EXIFを読み取って1枚1ページで並べます" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPhotos, Converter={StaticResource InverseBoolToVis}}" />

                <ScrollViewer Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PhotosItemsControl" ItemsSource="{Binding Photos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Width="110" Height="80" Stretch="Uniform"
                                               Source="{Binding Converter={StaticResource ThumbnailConverter}}"
                                               Margin="0,0,12,0" VerticalAlignment="Top" />

                                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Button Content="▲" Width="24" Margin="0,0,0,2"
                                                    Command="{Binding DataContext.MovePhotoUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="▼" Width="24" Margin="0,0,0,2"
                                                    Command="{Binding DataContext.MovePhotoDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Width="24" Foreground="DarkRed"
                                                    Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" Foreground="Gray" FontSize="11" Margin="0,0,0,4" />
                                            <DockPanel Margin="0,0,0,4"
                                                       Visibility="{Binding DataContext.TitleField.Enabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                <TextBlock DockPanel.Dock="Left" Text="タイトル:" VerticalAlignment="Center" Width="48" FontSize="11" />
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,4"
                                                       Visibility="{Binding DataContext.NoteField.Enabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                <TextBlock DockPanel.Dock="Left" Text="備考:" VerticalAlignment="Center" Width="48" FontSize="11" />
                                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,4">
                                                    <TextBlock Text="カメラ:" VerticalAlignment="Center" Width="40" FontSize="11" />
                                                    <ComboBox IsEditable="True" Width="160" FontSize="11"
                                                              Text="{Binding Camera, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding DataContext.CameraCandidates, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="レンズ:" VerticalAlignment="Center" Width="40" FontSize="11" />
                                                    <ComboBox IsEditable="True" Width="160" FontSize="11"
                                                              Text="{Binding Lens, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding DataContext.LensCandidates, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                                                    <TextBlock Text="焦点距離:" VerticalAlignment="Center" Width="40" FontSize="11" />
                                                    <TextBox Text="{Binding Focal, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="11" Margin="0,0,8,0" />
                                                    <TextBlock Text="SS:" VerticalAlignment="Center" Width="24" FontSize="11" />
                                                    <TextBox Text="{Binding Shutter, UpdateSourceTrigger=PropertyChanged}" Width="60" FontSize="11" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="F:" VerticalAlignment="Center" Width="24" FontSize="11" />
                                                    <TextBox Text="{Binding Aperture, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="11" Margin="0,0,8,0" />
                                                    <TextBlock Text="ISO:" VerticalAlignment="Center" Width="28" FontSize="11" />
                                                    <TextBox Text="{Binding Iso, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

            <!-- 右: スライドに入れる項目 -->
            <DockPanel Grid.Column="2" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="スライドに入れる項目" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                           Text="学籍番号・氏名・タイトルは上から順に配置。カメラ・レンズ・露出情報は下部(赤線の上下)、焦点距離は右カラム中央に固定です。" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding StudentIdField.Enabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left" Text="学籍番号:" VerticalAlignment="Center" Width="60" />
                        <TextBox Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <DockPanel Visibility="{Binding NameField.Enabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left" Text="氏名:" VerticalAlignment="Center" Width="60" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="▲" Width="22"
                                            Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="▼" Width="22"
                                            Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>

        <Border Grid.Row="3" Padding="8,6" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" />
        </Border>
    </Grid>
</Window>
