<Window x:Class="PhotoForumPPTX.App.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="新機能" Width="540" Height="520" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Button Content="OK" Click="OnCloseClick" Padding="20,6" HorizontalAlignment="Right" IsDefault="True" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" x:Name="NotesPanel">
                <TextBlock Text="新機能" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Foreground="Gray" Margin="0,2,0,16" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
